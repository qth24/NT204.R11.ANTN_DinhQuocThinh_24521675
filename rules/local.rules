# Local signature set for the IDS course project (Snort 2 syntax, BT3 scope).
# One rule per line; lines starting with # are comments.

# --- HTTP ---------------------------------------------------------------
alert tcp any any -> any 80 (msg:"HTTP GET request"; flow:to_server,established; content:"GET "; depth:4; classtype:web-application-activity; priority:3; sid:1000001; rev:1;)
alert tcp any any -> any 80 (msg:"HTTP POST request"; flow:to_server,established; content:"POST "; depth:5; classtype:web-application-activity; priority:3; sid:1000002; rev:1;)
alert tcp any any -> any 80 (msg:"Path traversal attempt"; flow:to_server,established; content:"GET "; depth:4; content:"../"; distance:0; classtype:web-application-attack; priority:1; sid:1000003; rev:1;)
alert tcp any any -> any 80 (msg:"SQL injection UNION SELECT"; flow:to_server,established; content:"union"; nocase; content:"select"; nocase; distance:1; within:10; classtype:web-application-attack; priority:1; sid:1000004; rev:1;)

# --- DNS ----------------------------------------------------------------
alert udp any any -> any 53 (msg:"DNS query to example.com"; content:"|07|example|03|com|00|"; nocase; classtype:misc-activity; priority:3; sid:1000010; rev:1;)

# --- SMTP ---------------------------------------------------------------
alert tcp any any -> any 25 (msg:"SMTP MAIL FROM command"; flow:to_server,established; content:"MAIL FROM"; nocase; depth:9; classtype:misc-activity; priority:3; sid:1000020; rev:1;)

# --- Scan / TCP flags ---------------------------------------------------
alert tcp any any -> any any (msg:"TCP SYN scan (bare SYN)"; flags:S; flow:to_server,not_established; classtype:attempted-recon; priority:2; sid:1000030; rev:1;)
alert tcp any any -> any any (msg:"TCP NULL scan"; flags:0; dsize:0; classtype:attempted-recon; priority:2; sid:1000031; rev:1;)
alert tcp any any -> any any (msg:"TCP XMAS scan"; flags:FPU; classtype:attempted-recon; priority:2; sid:1000032; rev:1;)
